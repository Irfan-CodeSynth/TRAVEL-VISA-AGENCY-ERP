# ─── Server ───────────────────────────────────────
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postgres?schema=public"

# JWT
JWT_ACCESS_SECRET=change-this-to-a-long-random-secret-for-access-tokens
JWT_REFRESH_SECRET=change-this-to-a-long-random-secret-for-refresh-tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=travel-visa-erpcrm
JWT_AUDIENCE=travel-visa-erpcrm-client

# Redis (optional, falls back to in-memory)
# REDIS_URL=redis://localhost:6379

# File Storage (local | s3)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=10

# S3 (when STORAGE_DRIVER=s3)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=

# Email (future)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# AI (future)
# OPENAI_API_KEY=

# ─── Client ───────────────────────────────────────
VITE_API_URL=http://localhost:4000/api/v1
VITE_APP_NAME="TravelCRM"
